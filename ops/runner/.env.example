# ==============================================================================
# E2E Runner Environment Configuration Example
#
# Copy this file to ops/runner/.env to customize host paths.
#
# IMPORTANT: Docker Compose resolves relative bind-mount paths relative to
# the directory containing compose.yaml (ops/runner/), NOT your current terminal cwd.
# To avoid path confusion, using absolute host paths is strongly recommended.
# ==============================================================================

# Optional local Gonka source, mounted read-only at /input/gonka.
# Remote sources (--gonka-repo) and replay packages (--from) need no local checkout.
# The wrappers set this automatically for --gonka-path. Direct Compose defaults
# to the repository root as an existing placeholder mount.
# Example (Windows): GONKA_DIR=C:/Users/User/Desktop/gonka
# Example (macOS/Linux): GONKA_DIR=/home/user/projects/gonka
# GONKA_DIR=../../../gonka

# Optional local contracts source, mounted read-only at /input/contracts.
# Set automatically by the wrappers for --contracts-path.
# For a sibling forward-contracts checkout, relative to ops/runner/compose.yaml:
CONTRACTS_DIR=../../../forward-contracts

# Destination directory on the host where exported suite evidence and reports are written
# Relative to ops/runner/compose.yaml: ../../out
OUTPUT_DIR=../../out

# ==============================================================================
# E2E explicit-SHA runner (service: e2e-runner). See ops/e2e/README.md.
# Required for image builds; use the build wrapper with an explicit runner SHA.
# E2E_RUNNER_SHA=<RUNNER_FULL_40_HEX_SHA>
# E2E_RUNNER_REPO=https://github.com/gonka24/forward-e2e.git
#
# You normally do NOT need to set any of these by hand: ops/e2e/run-e2e.sh and
# ops/e2e/Run-E2E.ps1 resolve and export them for you. They are listed here so
# that a direct `docker compose run e2e-runner ...` is also possible.
# ==============================================================================

# Locator of the runner image. A tag is only a locator; the immutable image id is
# what gets recorded in the plan and enforced at run time.
# E2E_RUNNER_IMAGE=forward-e2e-runner:local

# The wrapper resolves image identity on the host. For direct Compose plan/run/
# rerun commands, set E2E_RUNNER_IMAGE_ID to the output of this HOST command:
#   docker image inspect --format '{{.Id}}' forward-e2e-runner:local
# Use the same image locator as E2E_RUNNER_IMAGE. The container cannot inspect
# the host daemon; plan does not start its private daemon either.
# E2E_RUNNER_IMAGE_DIGEST is optional: set it to a RepoDigest from the same host
# inspection when one exists; a locally built image may have none.
# E2E_RUNNER_IMAGE_ID=
# E2E_RUNNER_IMAGE_DIGEST=

# Host directory holding an existing plan package, mounted read-only at
# /input/plan. Set automatically when you pass --from.
# E2E_PLAN_DIR=../..

# Host directory holding a token file for private repositories, mounted
# read-only at /run/secrets/e2e. Set automatically when you pass
# --credential-file. The token value itself never reaches argv, a URL, a log,
# the lock or the evidence.
# E2E_SECRETS_DIR=../..

# In-container path of the credential file, used as the default for
# --credential-file.
# E2E_CREDENTIAL_FILE=
