# Git metadata
.git
.gitignore

# Build outputs and temporary files
target/
**/target/
artifacts/
out/
runs/
tmp/
.a8-bundles/
.e2e-bridge*/
**/*.local.md
*.log
*.tmp
*.bin

# Python caches
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# IDE and OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Secrets and environment files
.env
.env.*
!ops/runner/.env.example

# Note on scope: ops/runner/Dockerfile never COPYs or ADDs from the build
# context (the runner is fetched by Git at E2E_RUNNER_SHA inside a RUN step),
# so this file only limits what a local-directory build uploads as context;
# it does not decide what ends up in the image. The negations below keep the
# context complete for anyone who does COPY it, nothing more.
# Synthetic evidence fixtures are required by tests/unit/runner/real_fixtures.py.
!tests/fixtures/**
# This committed probe is a versioned test fixture, not a local build output.
!harness/wasm_query_allowlist/artifacts/
!harness/wasm_query_allowlist/artifacts/**
